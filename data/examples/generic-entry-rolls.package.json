{
  "schemaVersion": 1,
  "kind": "rpg-system-package",
  "system": {
    "schemaVersion": 1,
    "id": "generic-roll-example",
    "name": "Exemplo de rolagens configuráveis",
    "diceSet": [
      6,
      8,
      100
    ],
    "characterTemplate": {
      "schemaVersion": 1,
      "meta": {
        "system": "generic-roll-example"
      },
      "name": "",
      "expertise": 3,
      "attributeBonus": 1,
      "energy": 5,
