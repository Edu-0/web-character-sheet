                      "label": "Nome"
                    },
                    {
                      "type": "number",
                      "field": "expertise",
                      "label": "Especialidade"
                    },
                    {
                      "type": "number",
                      "field": "energy",
                      "label": "Energia"
                    },
                    {
                      "type": "list",
                      "field": "techniques",
                      "label": "Técnicas",
                      "entryAction": "roll",
                      "rollPreset": "skillCheck",
                      "itemSchema": {
                        "name": "text",
                        "impact": "text",
                        "cost": "number",
                        "grade": "number"
                      }
                    },
                    {
                      "type": "list",
                      "field": "powers",
                      "label": "Poderes",
                      "entryAction": "roll",
                      "rollPreset": "power",
                      "itemSchema": {
                        "name": "text",
                        "impact": "text",
                        "cost": "number",
                        "grade": "number"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
