        {
          "id": "example-strike",
          "name": "Golpe de teste",
          "impact": "1d8 + 2",
          "cost": 0,
          "grade": 2
        }
      ],
      "powers": [
        {
          "id": "example-power",
          "name": "Pulso de teste",
          "impact": "2d6 + 1",
          "cost": 2,
          "grade": 2
        }
      ]
    },
    "formulas": {
      "checkBonus": "skill + attribute"
    },
    "entryRolls": {
      "skillCheck": {
        "buttonLabel": "Usar técnica",
        "submitLabel": "Testar",
        "check": {
          "label": "Teste",
          "expression": {
            "value": "2d6"
          },
          "modifier": {
            "formula": "checkBonus",
            "variables": {
              "skill": {
                "field": "expertise"
              },
              "attribute": {
                "field": "attributeBonus"
              }
            }
          }
        },
        "effect": {
          "expression": {
            "itemField": "impact"
          }
        }
      },
      "power": {
        "buttonLabel": "Ativar poder",
        "submitLabel": "Ativar",
        "noRollMessage": "Poder ativado sem dados.",
        "effect": {
          "expression": {
            "itemField": "impact"
          }
        },
        "scale": {
          "base": {
            "itemField": "grade"
          },
          "min": 0,
          "max": 20,
          "step": 2,
          "label": "Potência",
          "increment": {
            "value": "1d6"
          }
        },
        "resource": {
          "field": "energy",
          "mode": "remaining",
          "cost": {
            "itemField": "cost"
          },
          "label": "Consumir energia"
        }
      }
    }
  },
  "layouts": [
    {
      "schemaVersion": 1,
      "id": "generic-roll-example-layout",
      "system": "generic-roll-example",
      "tabs": [
        {
          "id": "main",
          "label": "Principal",
          "sections": [
            {
              "id": "actions",
              "title": "Ações",
              "containers": [
