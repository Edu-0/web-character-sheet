{
  "id": "sistema-rpg-layout",
  "system": "sistema-rpg",
  "description": "Layout declarativo da ficha do Sistema de RPG, organizado em abas, seções, containers e componentes genéricos.",
  "schemaVersion": 1,
  "tabs": [
    {
      "id": "identity",
      "label": "Identidade",
      "sections": [
        {
          "id": "identity-fields",
          "containers": [
            {
              "id": "identity-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "text",
                  "field": "name",
                  "label": "Nome"
                },
                {
                  "type": "text",
                  "field": "origin",
                  "label": "Origem"
                },
                {
                  "type": "textarea",
                  "field": "description",
                  "label": "Descrição"
                },
                {
                  "type": "textarea",
                  "field": "concept",
                  "label": "Conceito"
                },
                {
                  "type": "textarea",
                  "field": "appearance",
                  "label": "Aparência"
                },
                {
                  "type": "textarea",
                  "field": "personality",
                  "label": "Personalidade"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "progression",
      "label": "Progressão",
      "sections": [
        {
          "id": "progression-fields",
          "containers": [
            {
              "id": "progression-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "select",
                  "field": "quality",
                  "label": "Qualidade",
                  "optionsFrom": "system.qualityPresets"
                },
                {
                  "type": "number",
                  "field": "pointsAvailable",
                  "label": "Pontos Disponíveis"
                },
                {
                  "type": "number",
                  "field": "pointsSpent",
                  "label": "Pontos Gastos"
                },
                {
                  "type": "number",
                  "field": "evolutionPoints",
                  "label": "Pontos de Evolução"
                },
                {
                  "type": "tagList",
                  "field": "buffs",
                  "label": "Buffs"
                },
                {
                  "type": "tagList",
                  "field": "debuffs",
                  "label": "Debuffs"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "attributes",
      "label": "Atributos",
      "sections": [
        {
          "id": "attribute-fields",
          "containers": [
            {
              "id": "attribute-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "repeat": {
                "source": "system.attributes"
              },
              "components": [
                {
                  "type": "die",
                  "field": "attributes.{key}",
                  "label": "{label}"
                }
              ]
            }
          ]
        },
        {
          "id": "existence-die",
          "containers": [
            {
              "id": "existence-die-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "die",
                  "field": "existenceDie",
                  "label": "Dado de Existência"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "skills",
      "label": "Perícias",
      "sections": [
        {
          "id": "skill-fields",
          "containers": [
            {
              "id": "skill-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "repeat": {
                "source": "system.skillCategories[].skills"
              },
              "components": [
                {
                  "type": "die",
                  "field": "skills.{name}",
                  "label": "{name}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "specializations",
      "label": "Especializações",
      "sections": [
        {
          "id": "specialization-list",
          "containers": [
            {
              "id": "specialization-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "specializations",
                  "label": "Especializações",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "die": {
                      "type": "die",
                      "label": "Dado"
                    },
                    "techniqueIds": {
                      "type": "reference",
                      "label": "Técnicas relacionadas",
                      "multiple": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "essences",
      "label": "Essências",
      "sections": [
        {
          "id": "essence-list",
          "note": "Sempre exatamente 3 (essences.count/fixedCount no system.json).",
          "containers": [
            {
              "id": "essence-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "essences",
                  "label": "Essências",
                  "fixedLength": 3,
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Descrição"
                    },
                    "die": {
                      "type": "die",
                      "label": "Dado"
                    },
                    "gainActionResourceCondition": {
                      "type": "textarea",
                      "label": "Como ganha RA"
                    },
                    "spendActionResourceAbility": {
                      "type": "textarea",
                      "label": "Como gasta RA"
                    },
                    "passiveProperties": {
                      "type": "textarea",
                      "label": "Propriedades passivas"
                    },
                    "activeProperties": {
                      "type": "textarea",
                      "label": "Propriedades ativas"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "resources",
      "label": "Recursos",
      "sections": [
        {
          "id": "resource-fields",
          "containers": [
            {
              "id": "resource-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "counter",
                  "field": "resources.actionResource.current",
                  "label": "RA Atual"
                },
                {
                  "type": "resource",
                  "field": "resources.energy",
                  "label": "Energia"
                },
                {
                  "type": "boolean",
                  "field": "reaction.available",
                  "label": "Reação Disponível"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "techniques",
      "label": "Técnicas",
      "sections": [
        {
          "id": "technique-list",
          "containers": [
            {
              "id": "technique-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "techniques",
                  "label": "Técnicas",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "specializationId": {
                      "type": "select",
                      "label": "Especialização",
                      "optionsFrom": "character.specializations"
                    },
                    "maxDie": {
                      "type": "die",
                      "label": "Dado máximo"
                    },
                    "currentDie": {
                      "type": "die",
                      "label": "Dado atual"
                    },
                    "energyCost": {
                      "type": "number",
                      "label": "Custo de Energia"
                    },
                    "usage": {
                      "type": "text",
                      "label": "Uso"
                    },
                    "effect": {
                      "type": "textarea",
                      "label": "Efeito"
                    },
                    "roll": {
                      "type": "text",
                      "label": "Rolagem"
                    },
                    "resolution": {
                      "type": "text",
                      "label": "Resolução"
                    },
                    "activationTime": {
                      "type": "text",
                      "label": "Tempo de ativação"
                    },
                    "duration": {
                      "type": "text",
                      "label": "Duração"
                    },
                    "concentration": {
                      "type": "boolean",
                      "label": "Concentração"
                    },
                    "bonusAction": {
                      "type": "boolean",
                      "label": "Ação bônus"
                    },
                    "reaction": {
                      "type": "boolean",
                      "label": "Reação"
                    },
                    "limitations": {
                      "type": "textarea",
                      "label": "Limitações"
                    },
                    "reverse": {
                      "type": "textarea",
                      "label": "Reverso"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "equipment",
      "label": "Equipamentos",
      "sections": [
        {
          "id": "equipment-list",
          "containers": [
            {
              "id": "equipment-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "table",
                  "field": "inventory",
                  "label": "Armas, Armaduras e Equipamentos",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "type": {
                      "type": "select",
                      "label": "Tipo",
                      "options": [
                        "Arma",
                        "Armadura",
                        "Equipamento",
                        "Consumível",
                        "Ferramenta",
                        "Outro"
                      ]
                    },
                    "die": {
                      "type": "die",
                      "label": "Dado"
                    },
                    "weight": {
                      "type": "number",
                      "label": "Peso"
                    },
                    "quantity": {
                      "type": "number",
                      "label": "Quantidade"
                    },
                    "properties": {
                      "type": "text",
                      "label": "Propriedades"
                    },
                    "requirements": {
                      "type": "text",
                      "label": "Requisitos"
                    },
                    "state": {
                      "type": "text",
                      "label": "Estado"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "states",
      "label": "Estados",
      "sections": [
        {
          "id": "wear",
          "title": "Desgaste",
          "containers": [
            {
              "id": "wear-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "stateList",
                  "field": "states.wear",
                  "label": "Desgaste",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "sides": {
                      "type": "die",
                      "label": "Dado"
                    },
                    "temporary": {
                      "type": "boolean",
                      "label": "Temporário"
                    },
                    "source": {
                      "type": "text",
                      "label": "Origem"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "trauma",
          "title": "Trauma",
          "containers": [
            {
              "id": "trauma-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "stateList",
                  "field": "states.trauma",
                  "label": "Trauma",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "sides": {
                      "type": "die",
                      "label": "Dado"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "complications",
          "title": "Complicações",
          "containers": [
            {
              "id": "complications-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "stateList",
                  "field": "states.complications",
                  "label": "Complicações",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "sides": {
                      "type": "die",
                      "label": "Dado"
                    },
                    "note": {
                      "type": "text",
                      "label": "Observação"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "characteristics",
          "title": "Características",
          "containers": [
            {
              "id": "characteristics-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "stateList",
                  "field": "states.characteristics",
                  "label": "Características",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "sides": {
                      "type": "die",
                      "label": "Dado"
                    },
                    "note": {
                      "type": "text",
                      "label": "Observação"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "combat",
      "label": "Combate",
      "sections": [
        {
          "id": "combat-fields",
          "containers": [
            {
              "id": "combat-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "number",
                  "field": "velocity",
                  "label": "Velocidade (m)"
                },
                {
                  "type": "computed",
                  "formula": "carryCapacity",
                  "label": "Carga Máxima (kg)",
                  "variables": {
                    "strengthSides": {
                      "field": "attributes.strength"
                    },
                    "carryMultiplier": {
                      "system": "carryMultiplier"
                    }
                  }
                },
                {
                  "type": "computed",
                  "formula": "initiative",
                  "label": "Iniciativa",
                  "mode": "roll",
                  "actionLabel": "Rolar iniciativa",
                  "variables": {
                    "dexterityRoll": {
                      "rollField": "attributes.dexterity"
                    },
                    "willpowerRoll": {
                      "rollField": "attributes.willpower"
                    },
                    "velocity": {
                      "field": "velocity"
                    }
                  }
                },
                {
                  "type": "boolean",
                  "field": "reaction.available",
                  "label": "Reação Disponível"
                }
              ]
            }
          ]
        },
        {
          "id": "pool-builder",
          "title": "Montagem de Pool e Rolagem",
          "note": "Selecione Traços do personagem, role a Pool e resolva a ação contra uma oposição.",
          "containers": [
            {
              "id": "pool-builder-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "poolBuilder",
                  "label": "Pool de Ação",
                  "traitSources": [
                    {
                      "from": "system",
                      "collection": "attributes",
                      "id": "attribute:{key}",
                      "label": "{label} (Atributo)",
                      "sides": "attributes.{key}"
                    },
                    {
                      "kind": "field",
                      "id": "existence",
                      "label": "Dado de Existência",
                      "field": "existenceDie"
                    },
                    {
                      "kind": "entries",
                      "id": "skill:{key}",
                      "label": "{key} (Perícia)",
                      "field": "skills"
                    },
                    {
                      "from": "character",
                      "collection": "specializations",
              "require": "name",
                      "id": "specialization:{id}",
                      "label": "{name} (Especialização)",
                      "sides": "die"
                    },
                    {
                      "from": "character",
                      "collection": "essences",
              "require": "name",
                      "id": "essence:{id}",
                      "label": "{name} (Essência)",
                      "sides": "die"
                    },
                    {
                      "from": "character",
                      "collection": "techniques",
              "require": "name",
                      "id": "technique:{id}",
                      "label": "{name} (Técnica)",
                      "sides": "currentDie"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inventory",
      "label": "Inventário",
      "sections": [
        {
          "id": "inventory-list",
          "containers": [
            {
              "id": "inventory-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "table",
                  "field": "inventory",
                  "label": "Inventário",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "description": {
                      "type": "text",
                      "label": "Descrição"
                    },
                    "type": {
                      "type": "select",
                      "label": "Tipo",
                      "options": [
                        "Arma",
                        "Armadura",
                        "Equipamento",
                        "Consumível",
                        "Ferramenta",
                        "Outro"
                      ]
                    },
                    "die": {
                      "type": "die",
                      "label": "Dado"
                    },
                    "weight": {
                      "type": "number",
                      "label": "Peso"
                    },
                    "quantity": {
                      "type": "number",
                      "label": "Quantidade"
                    },
                    "properties": {
                      "type": "text",
                      "label": "Propriedades"
                    },
                    "requirements": {
                      "type": "text",
                      "label": "Requisitos"
                    },
                    "state": {
                      "type": "text",
                      "label": "Estado"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "notes",
      "label": "Notas",
      "sections": [
        {
          "id": "notes-field",
          "containers": [
            {
              "id": "notes-field-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "textarea",
                  "field": "notes",
                  "label": "Notas"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
