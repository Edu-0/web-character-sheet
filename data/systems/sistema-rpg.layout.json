{
  "id": "sistema-rpg-layout",
  "system": "sistema-rpg",
  "description": "Layout descritivo (páginas/seções/campos) para o Sistema de RPG. Documenta a organização visual esperada; o teste funcional (test-dice-pool.html) renderiza um subconjunto real destes campos através dos componentes genéricos do engine.",
  "schemaVersion": 1,
  "tabs": [
    {
      "id": "identity",
      "label": "Identidade",
      "sections": [
        {
          "id": "identity-fields",
          "containers": [
            {
              "id": "identity-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "text",
                  "field": "name",
                  "label": "Nome"
                },
                {
                  "type": "text",
                  "field": "origin",
                  "label": "Origem"
                },
                {
                  "type": "textarea",
                  "field": "description",
                  "label": "Descrição"
                },
                {
                  "type": "textarea",
                  "field": "concept",
                  "label": "Conceito"
                },
                {
                  "type": "textarea",
                  "field": "appearance",
                  "label": "Aparência"
                },
                {
                  "type": "textarea",
                  "field": "personality",
                  "label": "Personalidade"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "progression",
      "label": "Progressão",
      "sections": [
        {
          "id": "progression-fields",
          "containers": [
            {
              "id": "progression-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "select",
                  "field": "quality",
                  "label": "Qualidade",
                  "optionsFrom": "system.qualityPresets"
                },
                {
                  "type": "number",
                  "field": "pointsAvailable",
                  "label": "Pontos Disponíveis"
                },
                {
                  "type": "number",
                  "field": "pointsSpent",
                  "label": "Pontos Gastos"
                },
                {
                  "type": "number",
                  "field": "evolutionPoints",
                  "label": "Pontos de Evolução"
                },
                {
                  "type": "tagList",
                  "field": "buffs",
                  "label": "Buffs"
                },
                {
                  "type": "tagList",
                  "field": "debuffs",
                  "label": "Debuffs"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "attributes",
      "label": "Atributos",
      "sections": [
        {
          "id": "attribute-fields",
          "containers": [
            {
              "id": "attribute-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "repeat": {
                "source": "system.attributes"
              },
              "components": [
                {
                  "type": "die",
                  "field": "attributes.{key}",
                  "label": "{label}"
                }
              ]
            }
          ]
        },
        {
          "id": "existence-die",
          "containers": [
            {
              "id": "existence-die-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "die",
                  "field": "existenceDie",
                  "label": "Dado de Existência"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "skills",
      "label": "Perícias",
      "sections": [
        {
          "id": "skill-fields",
          "containers": [
            {
              "id": "skill-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "repeat": {
                "source": "system.skillCategories[].skills"
              },
              "components": [
                {
                  "type": "die",
                  "field": "skills.{name}",
                  "label": "{name}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "specializations",
      "label": "Especializações",
      "sections": [
        {
          "id": "specialization-list",
          "containers": [
            {
              "id": "specialization-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "specializations",
                  "label": "Especializações",
                  "itemSchema": {
                    "name": "text",
                    "die": "die",
                    "techniqueIds": "reference"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "essences",
      "label": "Essências",
      "sections": [
        {
          "id": "essence-list",
          "note": "Sempre exatamente 3 (essences.count/fixedCount no system.json).",
          "containers": [
            {
              "id": "essence-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "essences",
                  "label": "Essências",
                  "fixedLength": 3,
                  "itemSchema": {
                    "name": "text",
                    "description": "textarea",
                    "die": "die",
                    "gainActionResourceCondition": "textarea",
                    "spendActionResourceAbility": "textarea",
                    "passiveProperties": "textarea",
                    "activeProperties": "textarea"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "resources",
      "label": "Recursos",
      "sections": [
        {
          "id": "resource-fields",
          "containers": [
            {
              "id": "resource-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "counter",
                  "field": "resources.actionResource.current",
                  "label": "RA Atual"
                },
                {
                  "type": "resource",
                  "field": "resources.energy",
                  "label": "Energia"
                },
                {
                  "type": "boolean",
                  "field": "reaction.available",
                  "label": "Reação Disponível"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "techniques",
      "label": "Técnicas",
      "sections": [
        {
          "id": "technique-list",
          "containers": [
            {
              "id": "technique-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "techniques",
                  "label": "Técnicas",
                  "itemSchema": {
                    "name": "text",
                    "specializationId": "reference",
                    "maxDie": "die",
                    "currentDie": "die",
                    "energyCost": "number",
                    "usage": "text",
                    "effect": "textarea",
                    "roll": "text",
                    "resolution": "text",
                    "activationTime": "text",
                    "duration": "text",
                    "concentration": "boolean",
                    "bonusAction": "boolean",
                    "reaction": "boolean",
                    "limitations": "textarea",
                    "reverse": "textarea"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "equipment",
      "label": "Equipamentos",
      "sections": [
        {
          "id": "equipment-list",
          "containers": [
            {
              "id": "equipment-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "table",
                  "field": "inventory",
                  "label": "Armas, Armaduras e Equipamentos",
                  "itemSchema": {
                    "name": "text",
                    "type": "select",
                    "die": "die",
                    "weight": "number",
                    "quantity": "number",
                    "properties": "text",
                    "requirements": "text",
                    "state": "text"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "states",
      "label": "Estados",
      "sections": [
        {
          "id": "wear",
          "title": "Desgaste",
          "containers": [
            {
              "id": "wear-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "states.wear",
                  "label": "Desgaste",
                  "itemSchema": {
                    "name": "text",
                    "sides": "die",
                    "temporary": "boolean",
                    "source": "text"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "trauma",
          "title": "Trauma",
          "containers": [
            {
              "id": "trauma-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "states.trauma",
                  "label": "Trauma",
                  "itemSchema": {
                    "name": "text",
                    "sides": "die"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "complications",
          "title": "Complicações",
          "containers": [
            {
              "id": "complications-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "states.complications",
                  "label": "Complicações",
                  "itemSchema": {
                    "name": "text",
                    "sides": "die",
                    "note": "text"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "characteristics",
          "title": "Características",
          "containers": [
            {
              "id": "characteristics-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "states.characteristics",
                  "label": "Características",
                  "itemSchema": {
                    "name": "text",
                    "sides": "die",
                    "note": "text"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "combat",
      "label": "Combate",
      "sections": [
        {
          "id": "combat-fields",
          "containers": [
            {
              "id": "combat-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "number",
                  "field": "velocity",
                  "label": "Velocidade (m)"
                },
                {
                  "type": "computed",
                  "formula": "carryCapacity",
                  "label": "Carga Máxima (kg)"
                },
                {
                  "type": "computed",
                  "formula": "initiative",
                  "label": "Iniciativa"
                },
                {
                  "type": "boolean",
                  "field": "reaction.available",
                  "label": "Reação Disponível"
                }
              ]
            }
          ]
        },
        {
          "id": "pool-builder",
          "title": "Montagem de Pool e Rolagem",
          "note": "Renderizado de fato pelo test-dice-pool.html via engine/pool.js + engine/resolution.js.",
          "containers": [
            {
              "id": "pool-builder-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "poolBuilder",
                  "label": "Pool de Ação"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inventory",
      "label": "Inventário",
      "sections": [
        {
          "id": "inventory-list",
          "containers": [
            {
              "id": "inventory-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "table",
                  "field": "inventory",
                  "label": "Inventário",
                  "itemSchema": {
                    "name": "text",
                    "description": "text",
                    "type": "select",
                    "die": "die",
                    "weight": "number",
                    "quantity": "number",
                    "properties": "text",
                    "requirements": "text",
                    "state": "text"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "notes",
      "label": "Notas",
      "sections": [
        {
          "id": "notes-field",
          "containers": [
            {
              "id": "notes-field-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "textarea",
                  "field": "notes",
                  "label": "Notas"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
