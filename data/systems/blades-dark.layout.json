        {
          "id": "resources",
          "title": "Estresse e proteção",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "counter",
                  "field": "stress",
                  "label": "Estresse marcado",
                  "min": 0,
                  "max": 9,
                  "help": "Ao marcar a última caixa, resolva o trauma e a saída da cena com a mesa."
                },
                {
                  "type": "tagList",
                  "field": "trauma",
                  "label": "Traumas"
                },
                {
                  "type": "boolean",
                  "field": "armor.normal",
                  "label": "Armadura usada"
                },
                {
                  "type": "boolean",
                  "field": "armor.heavy",
                  "label": "Armadura pesada usada"
                },
                {
                  "type": "boolean",
                  "field": "armor.special",
                  "label": "Proteção especial usada"
                },
                {
                  "type": "counter",
                  "field": "healing",
                  "label": "Relógio de cura",
                  "min": 0,
                  "max": 4
                }
              ]
            }
          ]
        },
        {
          "id": "harm",
          "title": "Dano",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "text",
                  "field": "harm.oneA",
                  "label": "Nível 1 — A"
                },
                {
                  "type": "text",
                  "field": "harm.oneB",
                  "label": "Nível 1 — B"
                },
                {
                  "type": "text",
                  "field": "harm.twoA",
                  "label": "Nível 2 — A"
                },
                {
                  "type": "text",
                  "field": "harm.twoB",
                  "label": "Nível 2 — B"
                },
                {
                  "type": "text",
                  "field": "harm.three",
                  "label": "Nível 3"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "equipment",
