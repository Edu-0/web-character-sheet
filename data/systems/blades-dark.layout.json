{
  "schemaVersion": 1,
  "id": "blades-dark-layout",
  "system": "blades-dark",
  "name": "Padrão",
  "tabs": [
    {
      "id": "identity",
      "label": "Identidade",
      "sections": [
        {
          "id": "identity",
          "title": "Personagem",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "text",
                  "field": "identity.name",
                  "label": "Nome do personagem"
                },
                {
                  "type": "text",
                  "field": "identity.player",
                  "label": "Jogador"
                },
                {
                  "type": "textarea",
                  "field": "identity.description",
                  "label": "Descrição"
                }
              ]
            }
          ]
        },
        {
          "id": "background",
          "title": "Origem e papel",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "text",
                  "field": "identity.alias",
                  "label": "Alcunha"
                },
                {
                  "type": "text",
                  "field": "identity.heritage",
                  "label": "Herança"
                },
                {
                  "type": "text",
                  "field": "identity.background",
                  "label": "Antecedente"
                },
                {
                  "type": "text",
                  "field": "identity.playbook",
                  "label": "Playbook"
                },
                {
                  "type": "text",
                  "field": "identity.vice",
                  "label": "Vício e fornecedor"
                },
                {
                  "type": "list",
                  "field": "contacts",
                  "label": "Contatos",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Descrição"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "actions",
      "label": "Ações e resistência",
      "sections": [
        {
          "id": "insight",
          "title": "Discernimento",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "number",
                  "field": "actions.hunt",
                  "label": "Caçar"
                },
                {
                  "type": "number",
                  "field": "actions.study",
                  "label": "Estudar"
                },
                {
                  "type": "number",
                  "field": "actions.survey",
                  "label": "Observar"
                },
                {
                  "type": "number",
                  "field": "actions.tinker",
                  "label": "Manipular"
                },
                {
                  "type": "computed",
                  "label": "Resistência: Discernimento",
                  "formula": "insight"
                }
              ]
            }
          ]
        },
        {
          "id": "prowess",
          "title": "Destreza",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "number",
                  "field": "actions.finesse",
                  "label": "Refinar"
                },
                {
                  "type": "number",
                  "field": "actions.prowl",
                  "label": "Esgueirar"
                },
                {
                  "type": "number",
                  "field": "actions.skirmish",
                  "label": "Escaramuçar"
                },
                {
                  "type": "number",
                  "field": "actions.wreck",
                  "label": "Destruir"
                },
                {
                  "type": "computed",
                  "label": "Resistência: Destreza",
                  "formula": "prowess"
                }
              ]
            }
          ]
        },
        {
          "id": "resolve",
          "title": "Determinação",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "number",
                  "field": "actions.attune",
                  "label": "Sintonizar"
                },
                {
                  "type": "number",
                  "field": "actions.command",
                  "label": "Comandar"
                },
                {
                  "type": "number",
                  "field": "actions.consort",
                  "label": "Socializar"
                },
                {
                  "type": "number",
                  "field": "actions.sway",
                  "label": "Convencer"
                },
                {
                  "type": "computed",
                  "label": "Resistência: Determinação",
                  "formula": "resolve"
                }
              ]
            }
          ]
        },
        {
          "id": "checks",
          "title": "Testes",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "select",
                  "field": "position",
                  "label": "Posição",
                  "options": [
                    {
                      "value": "controlled",
                      "label": "Controlada"
                    },
                    {
                      "value": "risky",
                      "label": "Arriscada"
                    },
                    {
                      "value": "desperate",
                      "label": "Desesperada"
                    }
                  ]
                },
                {
                  "type": "select",
                  "field": "effect",
                  "label": "Efeito",
                  "options": [
                    {
                      "value": "limited",
                      "label": "Limitado"
                    },
                    {
                      "value": "standard",
                      "label": "Padrão"
                    },
                    {
                      "value": "great",
                      "label": "Grande"
                    }
                  ]
                },
                {
                  "type": "checkRoll",
                  "configFrom": "checks.action",
                  "label": "Teste de ação"
                },
                {
                  "type": "checkRoll",
                  "configFrom": "checks.resistance",
                  "label": "Teste de resistência"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "resources",
      "label": "Estresse e dano",
