          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "select",
                  "field": "load",
                  "label": "Carga escolhida",
                  "options": [
                    {
                      "value": "light",
                      "label": "Leve (3)"
                    },
                    {
                      "value": "normal",
                      "label": "Normal (5)"
                    },
                    {
                      "value": "heavy",
                      "label": "Pesada (6)"
                    }
                  ]
                },
                {
                  "type": "number",
                  "field": "coin",
                  "label": "Moedas"
                },
                {
                  "type": "number",
                  "field": "stash",
                  "label": "Reserva"
                },
                {
                  "type": "list",
                  "field": "inventory",
                  "label": "Itens e carga",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Descrição"
                    }
                  }
                },
                {
                  "type": "list",
                  "field": "abilities",
                  "label": "Habilidades especiais",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Descrição"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "clocks",
          "title": "Relógios e projetos",
          "containers": [
            {
              "layout": {
                "type": "stack",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "list",
                  "field": "clocks",
                  "label": "Relógios",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Objetivo"
                    },
                    "filled": {
                      "type": "number",
                      "label": "Segmentos marcados"
                    },
                    "segments": {
                      "type": "number",
                      "label": "Total de segmentos",
                      "default": 4
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Condições e consequências"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "notes",
      "label": "Notas e cobertura",
      "sections": [
        {
          "id": "notes",
          "title": "Registros da mesa",
          "containers": [
            {
              "layout": {
                "type": "stack",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "textarea",
                  "field": "notes",
                  "label": "Notas da sessão"
                },
                {
                  "type": "list",
                  "field": "advances",
                  "label": "Criação e evolução — registro manual",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Descrição"
                    }
                  }
                }
              ]
            }
          ],
          "note": "Ficha de personagem baseada no SRD original de Blades in the Dark, sem Deep Cuts. Ações, resistência e registros de estresse, trauma, dano, carga, moedas e relógios. Posição, efeito, ajuda/esforço, consequências, custos, recuperação, vício e evolução são manuais. Bando/campanha e catálogos de playbooks não são automatizados."
        }
      ]
    }
  ]
}
