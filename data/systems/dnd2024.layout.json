{
  "id": "dnd2024-layout",
  "system": "dnd2024",
  "description": "Descrição da organização visual atual da ficha. Ainda não é consumida pelo renderer genérico (js/ui.js continua desenhando esta versão da interface) — existe para documentar a separação entre dados/regras e apresentação, e para servir de ponto de partida quando a interface migrar para o renderer genérico (engine/renderer.js).",
  "schemaVersion": 1,
  "tabs": [
    {
      "id": "identity",
      "label": "Identidade",
      "sections": [
        {
          "id": "identity-header",
          "title": "Identidade",
          "containers": [
            {
              "id": "identity-header-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "text",
                  "field": "identity.name",
                  "label": "Nome do personagem"
                },
                {
                  "type": "text",
                  "field": "identity.player",
                  "label": "Jogador"
                },
                {
                  "type": "text",
                  "field": "identity.class",
                  "label": "Classe"
                },
                {
                  "type": "number",
                  "field": "identity.level",
                  "label": "Nível"
                },
                {
                  "type": "text",
                  "field": "identity.species",
                  "label": "Espécie"
                },
                {
                  "type": "text",
                  "field": "identity.background",
                  "label": "Antecedente"
                },
                {
                  "type": "text",
                  "field": "identity.alignment",
                  "label": "Alinhamento"
                },
                {
                  "type": "number",
                  "field": "identity.experience",
                  "label": "Experiência"
                },
                {
                  "type": "boolean",
                  "field": "identity.inspiration",
                  "label": "Inspiração"
                }
              ]
            }
          ]
        },
        {
          "id": "vitals",
          "title": "Estado Vital",
          "notes": "combat.hp* ainda são campos legados 'planos' no character.json (não usam o tipo 'resource' current/max ainda). Migrar para um recurso único 'combat.hitPoints' é um passo futuro documentado no resumo da arquitetura.",
          "containers": [
            {
              "id": "vitals-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "number",
                  "field": "combat.ac",
                  "label": "Classe de Armadura"
                },
                {
                  "type": "number",
                  "field": "combat.speed",
                  "label": "Deslocamento"
                },
                {
                  "type": "number",
                  "field": "combat.hpCurrent",
                  "label": "PV Atual"
                },
                {
                  "type": "number",
                  "field": "combat.hpMax",
                  "label": "PV Máximo"
                },
                {
                  "type": "number",
                  "field": "combat.hpTemp",
                  "label": "PV Temporário"
                }
              ]
            }
          ]
        },
        {
          "id": "abilities",
          "title": "Atributos",
          "containers": [
            {
              "id": "abilities-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "repeat": {
                "source": "system.abilities"
              },
              "components": [
                {
                  "type": "number",
                  "field": "abilities.{key}.score",
                  "label": "{label}"
                }
              ]
            }
          ]
        },
        {
          "id": "skills",
          "title": "Perícias",
          "containers": [
            {
              "id": "skills-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "repeat": {
                "source": "system.skills"
              },
              "components": [
                {
                  "type": "boolean",
                  "field": "skills.{key}.proficient",
                  "label": "{label}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "combat",
      "label": "Combate",
      "sections": [
        {
          "id": "attacks",
          "title": "Ataques e Ações",
          "containers": [
            {
              "id": "attacks-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "combat.attacks",
                  "label": "Ataques",
                  "itemSchema": {
                    "name": "text",
                    "bonus": "text",
                    "damage": "text",
                    "damageType": "text",
                    "range": "text",
                    "properties": "text",
                    "notes": "textarea"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "conditions",
          "title": "Condições Ativas",
          "containers": [
            {
              "id": "conditions-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "tagList",
                  "field": "combat.conditions",
                  "label": "Condições"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "features",
      "label": "Habilidades",
      "sections": [
        {
          "id": "features-list",
          "title": "Habilidades e Recursos",
          "containers": [
            {
              "id": "features-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "features",
                  "label": "Habilidades",
                  "itemSchema": {
                    "name": "text",
                    "source": "select",
                    "usesCurrent": "number",
                    "usesMax": "number",
                    "description": "textarea",
                    "notes": "textarea"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "spells",
      "label": "Magias",
      "sections": [
        {
          "id": "spellcasting-summary",
          "title": "Conjuração",
          "containers": [
            {
              "id": "spellcasting-summary-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "select",
                  "field": "spellcasting.ability",
                  "label": "Atributo de Conjuração"
                },
                {
                  "type": "computed",
                  "formula": "spellSaveDC",
                  "label": "CD de Magia"
                },
                {
                  "type": "computed",
                  "formula": "spellAttackBonus",
                  "label": "Bônus de Ataque"
                }
              ]
            }
          ]
        },
        {
          "id": "spell-slots",
          "title": "Espaços de Magia",
          "containers": [
            {
              "id": "spell-slots-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "slotTracker",
                  "field": "spellcasting.slots",
                  "label": "Espaços por nível"
                }
              ]
            }
          ]
        },
        {
          "id": "spell-list",
          "title": "Magias",
          "containers": [
            {
              "id": "spell-list-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "list",
                  "field": "spellcasting.spells",
                  "label": "Magias",
                  "itemSchema": {
                    "name": "text",
                    "level": "select",
                    "school": "text",
                    "prepared": "boolean",
                    "castingTime": "text",
                    "range": "text",
                    "duration": "text",
                    "components": "text",
                    "description": "textarea"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "inventory",
      "label": "Inventário",
      "sections": [
        {
          "id": "currency",
          "title": "Moedas",
          "containers": [
            {
              "id": "currency-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "number",
                  "field": "inventory.currency.pp",
                  "label": "PP"
                },
                {
                  "type": "number",
                  "field": "inventory.currency.gp",
                  "label": "PO"
                },
                {
                  "type": "number",
                  "field": "inventory.currency.ep",
                  "label": "PE"
                },
                {
                  "type": "number",
                  "field": "inventory.currency.sp",
                  "label": "PP(prata)"
                },
                {
                  "type": "number",
                  "field": "inventory.currency.cp",
                  "label": "PC"
                }
              ]
            }
          ]
        },
        {
          "id": "items",
          "title": "Itens",
          "containers": [
            {
              "id": "items-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "table",
                  "field": "inventory.items",
                  "label": "Itens",
                  "itemSchema": {
                    "name": "text",
                    "qty": "number",
                    "weight": "number",
                    "value": "number",
                    "category": "select",
                    "equipped": "boolean",
                    "notes": "text"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "personality",
      "label": "Personalidade",
      "sections": [
        {
          "id": "personality-fields",
          "title": "Personalidade",
          "containers": [
            {
              "id": "personality-fields-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "textarea",
                  "field": "personality.traits",
                  "label": "Traços de Personalidade"
                },
                {
                  "type": "textarea",
                  "field": "personality.ideals",
                  "label": "Ideais"
                },
                {
                  "type": "textarea",
                  "field": "personality.bonds",
                  "label": "Vínculos"
                },
                {
                  "type": "textarea",
                  "field": "personality.flaws",
                  "label": "Defeitos"
                },
                {
                  "type": "textarea",
                  "field": "personality.appearance",
                  "label": "Aparência"
                },
                {
                  "type": "textarea",
                  "field": "personality.backstory",
                  "label": "História"
                },
                {
                  "type": "textarea",
                  "field": "personality.allies",
                  "label": "Aliados e Organizações"
                },
                {
                  "type": "textarea",
                  "field": "personality.notes",
                  "label": "Notas"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "proficiencies",
      "label": "Proficiências",
      "sections": [
        {
          "id": "proficiency-lists",
          "title": "Proficiências e Idiomas",
          "containers": [
            {
              "id": "proficiency-lists-container",
              "layout": {
                "type": "grid",
                "min": "min(100%, 220px)",
                "gap": 16
              },
              "components": [
                {
                  "type": "tagList",
                  "field": "proficiencies.armor",
                  "label": "Armaduras"
                },
                {
                  "type": "tagList",
                  "field": "proficiencies.weapons",
                  "label": "Armas"
                },
                {
                  "type": "tagList",
                  "field": "proficiencies.tools",
                  "label": "Ferramentas"
                },
                {
                  "type": "tagList",
                  "field": "proficiencies.languages",
                  "label": "Idiomas"
                },
                {
                  "type": "tagList",
                  "field": "proficiencies.other",
                  "label": "Outras Proficiências"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
