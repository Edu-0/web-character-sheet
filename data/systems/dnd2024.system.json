  "formulas": {
    "abilityModifier": "floor((value - 10) / 2)",
    "proficiencyBonus": "2 + floor((level - 1) / 4)",
    "savingThrow": "abilityModifier + if(proficient, proficiencyBonus, 0)",
    "skillModifier": "abilityModifier + if(expertise, proficiencyBonus * 2, if(proficient, proficiencyBonus, 0))",
    "passivePerception": "10 + perceptionModifier",
    "initiative": "dexterityModifier + initiativeBonus",
    "spellSaveDC": "8 + proficiencyBonus + spellAbilityModifier",
    "spellAttackBonus": "proficiencyBonus + spellAbilityModifier",
    "carryCapacity": "strengthScore * 7.5"
