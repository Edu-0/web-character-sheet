{
  "schemaVersion": 1,
  "id": "cthulhu7-table",
  "system": "cthulhu7",
  "name": "Modo mesa",
  "mode": "table",
  "tabs": [
    {
      "id": "play",
      "label": "Em jogo",
      "sections": [
        {
          "id": "checks",
          "title": "Teste percentual",
          "containers": [
            {
              "layout": {
                "type": "stack",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "checkRoll",
                  "configFrom": "checks.skill",
                  "label": "Teste percentual"
                }
              ]
            }
          ]
        },
        {
          "id": "resources",
          "title": "Recursos e condições",
          "containers": [
            {
              "layout": {
                "type": "grid",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "resource",
                  "field": "hp",
                  "label": "Pontos de vida"
                },
                {
                  "type": "resource",
                  "field": "mp",
                  "label": "Pontos de magia"
                },
                {
                  "type": "resource",
                  "field": "sanity",
                  "label": "Sanidade"
                },
                {
                  "type": "number",
                  "field": "luck",
                  "label": "Sorte"
                },
                {
                  "type": "number",
                  "field": "move",
                  "label": "Movimento"
                },
                {
                  "type": "text",
                  "field": "build",
                  "label": "Corpo"
                },
                {
                  "type": "text",
                  "field": "damageBonus",
                  "label": "Bônus de dano"
                },
                {
                  "type": "textarea",
                  "field": "conditions",
                  "label": "Ferimentos e condições"
                }
              ]
            }
          ]
        },
        {
          "id": "skills",
          "title": "Perícias",
          "containers": [
            {
              "layout": {
                "type": "stack",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "list",
                  "field": "skills",
                  "label": "Perícias do investigador",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Perícia"
                    },
                    "rating": {
                      "type": "number",
                      "label": "Percentual"
                    },
                    "development": {
                      "type": "boolean",
                      "label": "Marcada para evolução"
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Observações"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "notes",
      "label": "Notas e cobertura",
      "sections": [
        {
          "id": "notes",
          "title": "Registros da mesa",
          "containers": [
            {
              "layout": {
                "type": "stack",
                "min": 220,
                "gap": 12
              },
              "components": [
                {
                  "type": "textarea",
                  "field": "notes",
                  "label": "Notas da sessão"
                },
                {
                  "type": "list",
                  "field": "advances",
                  "label": "Criação e evolução — registro manual",
                  "itemSchema": {
                    "name": {
                      "type": "text",
                      "label": "Nome"
                    },
                    "description": {
                      "type": "textarea",
                      "label": "Descrição"
                    }
                  }
                }
              ]
            }
          ],
          "note": "Cobertura do Quick-Start 7e da Chaosium (2021): registro de investigador e graus percentis, com bônus/penalidade. Criação, valores-base de perícias, máximos dos recursos, dano/bônus de dano, sanidade, críticos/desastres, testes opostos, testes forçados e evolução são manuais. Preencha os valores usando a referência da mesa."
        }
      ]
    }
  ]
}
